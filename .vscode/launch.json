{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Debug (Conda + PDM)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",  // Replace 'main' with your actual entry point file
                "--reload"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "preLaunchTask": "activate_conda_and_pdm"
        }
    ]
}
